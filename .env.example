# Copy to .env (chmod 600). Nothing here is baked into the image.
HISTOR_PROFILE=dev                       # prod requires the three lines below
HISTOR_PUBLIC_BASE=http://127.0.0.1:9490 # prod: https://histor.modelmarket.dev
HISTOR_OPERATOR_TOKEN=                   # prod: >= 24 chars; guards /api/v1/admin/*
HISTOR_DATABASE_URL=                     # empty = SQLite (dev); prod: postgresql://…
HISTOR_POSTGRES_PASSWORD=                # used by docker-compose.postgres.yml
HISTOR_CRAWL_INTERVAL_S=86400            # 0 = crawl only when an operator asks
HISTOR_CRAWL_ON_START=1
HISTOR_CRAWL_WORKERS=12
HISTOR_CRAWL_PER_HOST=2                  # politeness: concurrent connections per host
HISTOR_CRAWL_TIMEOUT_S=20
HISTOR_CRAWL_LIMIT=0                     # dev: observe only the first N endpoints
HISTOR_CRAWL_BATCH=400                   # endpoints saved together; a restart loses at most one batch
HISTOR_CHECK_RATE_PER_MIN=30
HISTOR_CHECK_SCAN_RATE_PER_HOUR=20
HISTOR_PQC=0                             # 1 = hybrid Ed25519 + ML-DSA-65 federation signatures
