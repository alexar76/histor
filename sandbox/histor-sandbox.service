[Unit]
Description=HISTOR package sandbox (observes npm/PyPI MCP servers under gVisor)
After=docker.service network-online.target
Requires=docker.service

[Service]
User=histor-sandbox
Group=histor-sandbox
SupplementaryGroups=docker
EnvironmentFile=/etc/histor-sandbox.env
ExecStart=/usr/local/bin/histor-observe serve
Restart=on-failure
RestartSec=5
# The DNS logger answers on the internal network's gateway, port 53.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/histor-sandbox
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
