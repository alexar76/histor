# Install as /etc/nginx/snippets/histor-momus-receipt-proxy.conf on the HISTOR
# edge host. Replace the TEST-NET address with the live admin-vps A record that
# serves histor.modelmarket.dev's MOMUS receipts. Never commit the live IP.
proxy_pass https://203.0.113.20;
proxy_set_header Host histor.modelmarket.dev;
proxy_ssl_server_name on;
proxy_ssl_name histor.modelmarket.dev;
# Verify the origin. Besides the receipt itself, nginx shares one TLS session per upstream address
# between locations: an unverified handshake here once handed its verify result 20 to the verified
# ERC-8004 feedback proxy to the same host (502s, 2026-11-13/14).
proxy_ssl_verify on;
proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
proxy_ssl_verify_depth 3;
proxy_connect_timeout 5s;
proxy_read_timeout 10s;
proxy_hide_header Cache-Control;
add_header Cache-Control "no-store" always;
