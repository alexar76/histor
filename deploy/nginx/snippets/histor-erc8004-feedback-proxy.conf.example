# On an edge separate from the weekly runner, install this as
# /etc/nginx/snippets/histor-erc8004-feedback-proxy.conf. Omit it when the runner is local.
# It needs the cache zone from conf.d/histor-erc8004-feedback-cache.conf.example in the http block.
# Replace the TEST-NET address with the HTTPS origin of the weekly feedback runner.
# The original HISTOR vhost on that host serves /var/www/warden-feedback at this path.
proxy_pass https://203.0.113.20/.well-known/erc-8004/feedback/;
proxy_set_header Host histor.modelmarket.dev;
proxy_ssl_server_name on;
proxy_ssl_name histor.modelmarket.dev;
proxy_ssl_verify on;
proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
proxy_ssl_verify_depth 3;
# A full, verified handshake per request. nginx keeps one TLS session per upstream address, and the
# MOMUS receipt locations proxy to the same address without verification (no CA file): resuming the
# session one of them saved hands this location that handshake's verify result, and nginx answers 502
# "upstream SSL certificate verify error: (20:unable to get local issuer certificate)". On the edge
# 2026-11-13/14 that failed most hourly reads of last-run.json (reproduced 15/15 on a test nginx;
# 0/15 with reuse off). The files change weekly, so the saved round trip is worth nothing.
proxy_ssl_session_reuse off;
proxy_connect_timeout 5s;
proxy_read_timeout 10s;
# The runner is on another host: when it cannot be reached, serve the last copy this edge received,
# byte for byte (each on-chain feedback commits to its file by keccak). A copy is fresh for a minute,
# so a new run shows up at once; staleness of the runner itself is judged from ranAt in last-run.json.
proxy_cache histor_erc8004_feedback;
proxy_cache_key $request_uri;   # survives a change of the runner's address
proxy_cache_valid 200 1m;
proxy_cache_use_stale error timeout http_500 http_502 http_503 http_504;
proxy_cache_lock on;
add_header X-Cache-Status $upstream_cache_status always;
proxy_hide_header Access-Control-Allow-Origin;
proxy_hide_header Strict-Transport-Security;
proxy_hide_header X-Content-Type-Options;
