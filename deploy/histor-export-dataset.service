# /etc/systemd/system/histor-export-dataset.service — runs deploy/export_dataset.sh (installed as
# /usr/local/sbin/histor-export-dataset). One snapshot a week, taken between two crawl cycles.
[Unit]
Description=HISTOR weekly open-data snapshot (/datasets/)
After=docker.service
[Service]
Type=oneshot
ExecStart=/usr/local/sbin/histor-export-dataset
Nice=10
IOSchedulingClass=idle
